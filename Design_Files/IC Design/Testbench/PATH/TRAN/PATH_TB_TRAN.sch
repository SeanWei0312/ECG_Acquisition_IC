alterparam VDIFF_DC_SET=0


* Startup with reset
alterparam TEST_FREQ=60
alterparam ECG_AMP_SET=0

alterparam VDIFF_DC_SET=300m
alterparam VCM_DC_SET=0
alterparam VCM_AC_SET=0

alterparam VDD_RIPPLE_SET=0
alterparam VSS_RIPPLE_SET=0

alterparam S1_SET=3.3
alterparam S0_SET=3.3

alterparam RST_ENABLE_SET=0
alterparam RST_PULSE_ENABLE_SET=1

reset

option method=gear
option maxord=2
option plotwinsize=0

tran 100u 200m 0 20u

let tr_vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
let tr_vin_diff=v(INP)-v(INN)

let tr_vout_cm=0.5*(v(OUTP)+v(OUTN))-v(AGND)
let tr_vout_diff=v(OUTP)-v(OUTN)

let tr_outp=v(OUTP)-v(AGND)
let tr_outn=v(OUTN)-v(AGND)

let tr_rld=v(RLD)-v(AGND)

setscale time

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.startup_with_reset.txt v(RST) v(CLK) tr_vin_cm tr_vin_diff tr_vout_cm tr_vout_diff tr_outp tr_outn tr_rld

destroy $curplot


