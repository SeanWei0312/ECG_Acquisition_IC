alterparam RST_PULSE_ENABLE_SET=0

reset

option method=gear
option maxord=2
option plotwinsize=0

tran 100u 200m 0 20u

let tr_vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
let tr_vin_diff=v(INP)-v(INN)

let tr_vout_cm=0.5*(v(OUTP)+v(OUTN))-v(AGND)
let tr_vout_diff=v(OUTP)-v(OUTN)

let tr_outp=v(OUTP)-v(AGND)
let tr_outn=v(OUTN)-v(AGND)

let tr_rld=v(RLD)-v(AGND)

setscale time

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.startup_without_reset.txt v(RST) v(CLK) tr_vin_cm tr_vin_diff tr_vout_cm tr_vout_diff tr_outp tr_outn tr_rld

destroy $curplot

alterparam VDIFF_DC_SET=0


* RLD
alterparam TEST_FREQ=60

alterparam ECG_AMP_SET=0
alterparam VDIFF_DC_SET=0

alterparam VCM_DC_SET=0
alterparam VCM_AC_SET=100m

alterparam VDD_RIPPLE_SET=0
alterparam VSS_RIPPLE_SET=0

alterparam S1_SET=3.3
alterparam S0_SET=3.3

alterparam RCM_SOURCE_SET=1Meg

alterparam RELECP_SET=80k
alterparam RELECN_SET=120k

alterparam CELECP_SET=120n
alterparam CELECN_SET=80n

alterparam RST_ENABLE_SET=0
alterparam RST_PULSE_ENABLE_SET=1


* RLD off
alterparam RLD_RETURN_SET=100T
reset

option method=gear
option maxord=2
option plotwinsize=0

tran 100u 300m 0 20u

let tr_body=v(BODY)-v(AGND)

let tr_vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
let tr_vin_diff=v(INP)-v(INN)

let tr_rld=v(RLD)-v(AGND)
let tr_irld=(v(RLD)-v(BODY))/100T

let tr_vout_cm=0.5*(v(OUTP)+v(OUTN))-v(AGND)
let tr_vout_diff=v(OUTP)-v(OUTN)

setscale time

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.rld_off.txt tr_body tr_vin_cm tr_vin_diff tr_rld tr_irld tr_vout_cm tr_vout_diff v(RST)

destroy $curplot


* RLD on
alterparam RLD_RETURN_SET=1Meg
reset

option method=gear
option maxord=2
option plotwinsize=0

tran 100u 300m 0 20u

let tr_body=v(BODY)-v(AGND)

let tr_vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
let tr_vin_diff=v(INP)-v(INN)

let tr_rld=v(RLD)-v(AGND)
let tr_irld=(v(RLD)-v(BODY))/1Meg

let tr_vout_cm=0.5*(v(OUTP)+v(OUTN))-v(AGND)
let tr_vout_diff=v(OUTP)-v(OUTN)

setscale time

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.rld_on.txt tr_body tr_vin_cm tr_vin_diff tr_rld tr_irld tr_vout_cm tr_vout_diff v(RST)

destroy $curplot


* Restore RLD
alterparam RCM_SOURCE_SET=1

alterparam RELECP_SET=1
alterparam RELECN_SET=1

alterparam CELECP_SET=1f
alterparam CELECN_SET=1f

alterparam RLD_RETURN_SET=100T

alterparam VCM_AC_SET=0


* THD
alterparam CLK_TR=20u
alterparam CLK_TF=20u
alterparam CLK_PW=980u

alterparam VCM_DC_SET=0
alterparam VCM_AC_SET=0
alterparam VDIFF_DC_SET=0

alterparam VDD_RIPPLE_SET=0
alterparam VSS_RIPPLE_SET=0

alterparam RLD_RETURN_SET=100T

alterparam RST_ENABLE_SET=0
alterparam RST_PULSE_ENABLE_SET=1

foreach freq 60 150

    alterparam TEST_FREQ=$freq

    foreach cfg 0 1

        if $cfg = 0
            alterparam ECG_AMP_SET=0.25m
            alterparam S1_SET=3.3
            alterparam S0_SET=3.3
        else
            alterparam ECG_AMP_SET=2.5m
            alterparam S1_SET=0
            alterparam S0_SET=0
        end

        reset

        option method=trap
        option maxord=2
        option plotwinsize=0

        setplot const

        let tstop=0.100+11/$freq

        tran 20u $&tstop 0 5u

        let tr_cfg=time*0+$cfg
        let tr_freq=time*0+$freq

        if $cfg = 0
            let tr_vin_pp=time*0+0.5m
            let tr_pga_gain=time*0+16
        else
            let tr_vin_pp=time*0+5m
            let tr_pga_gain=time*0+2
        end

        let tr_vin_diff=v(INP)-v(INN)

        let tr_vout_cm=0.5*(v(OUTP)+v(OUTN))-v(AGND)
        let tr_vout_diff=v(OUTP)-v(OUTN)

        setscale time

        wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.thd_tran.txt tr_cfg tr_freq tr_vin_pp tr_pga_gain tr_vin_diff tr_vout_cm tr_vout_diff v(RST)

        destroy $curplot

    end
end


* Restore
alterparam CLK_FREQ=500
alterparam CLK_TR=80u
alterparam CLK_TF=80u
alterparam CLK_PW=920u
alterparam CLK_DELAY_SET=1m

alterparam ECG_AMP_SET=0

alterparam VDIFF_DC_SET=0
alterparam VCM_DC_SET=0
alterparam VCM_AC_SET=0

alterparam VDD_RIPPLE_SET=0
alterparam VSS_RIPPLE_SET=0

alterparam RST_ENABLE_SET=1
alterparam TRESET=10m
alterparam TRESET_END=10.001m

alterparam RST_PULSE_ENABLE_SET=0
alterparam RST_PULSE_ON_SET=40m
alterparam RST_PULSE_ON_END_SET=40.001m
alterparam RST_PULSE_OFF_SET=60m
alterparam RST_PULSE_OFF_END_SET=60.001m

alterparam SIG_DELAY_SET=100m

alterparam OFFSET_DELAY_SET=20m
alterparam OFFSET_RISE_SET=10m

alterparam RCM_SOURCE_SET=1

alterparam RELECP_SET=1
alterparam RELECN_SET=1

alterparam CELECP_SET=1f
alterparam CELECN_SET=1f

alterparam RLD_RETURN_SET=100T

alterparam S1_SET=3.3
alterparam S0_SET=3.3

option method=gear
option maxord=2
option plotwinsize=0

* quit
.endc
