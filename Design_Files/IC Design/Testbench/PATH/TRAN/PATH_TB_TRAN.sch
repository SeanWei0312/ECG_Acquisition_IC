alterparam VDD_RIPPLE_SET=0
alterparam VSS_RIPPLE_SET=0


* VCM offset
alterparam TEST_FREQ=60

alterparam ECG_AMP_SET=0
alterparam VDIFF_DC_SET=0

alterparam VCM_DC_SET=0
alterparam VCM_AC_SET=0

alterparam VDD_RIPPLE_SET=0
alterparam VSS_RIPPLE_SET=0

alterparam RST_ENABLE_SET=0
alterparam RST_PULSE_ENABLE_SET=1

foreach cfg 0 1

    if $cfg = 0
        alterparam ECG_AMP_SET=0.25m
        alterparam S1_SET=3.3
        alterparam S0_SET=3.3
    else
        alterparam ECG_AMP_SET=2.5m
        alterparam S1_SET=0
        alterparam S0_SET=0
    end

    foreach off 500m 300m 0 -300m -500m

        alterparam VCM_DC_SET=$off
        reset

        option method=gear
        option maxord=2
        option plotwinsize=0

        tran 100u 300m 0 20u

        let tr_cfg=time*0+$cfg
        let tr_offset=time*0+$off

        if $cfg = 0
            let tr_input_pp=time*0+0.5m
            let tr_pga_gain=time*0+16
        else
            let tr_input_pp=time*0+5m
            let tr_pga_gain=time*0+2
        end

        let tr_vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
        let tr_vin_diff=v(INP)-v(INN)

        let tr_vout_cm=0.5*(v(OUTP)+v(OUTN))-v(AGND)
        let tr_vout_diff=v(OUTP)-v(OUTN)

        let tr_rld=v(RLD)-v(AGND)

        setscale time

        wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.vcmdcoffset_tran.txt tr_cfg tr_input_pp tr_pga_gain tr_offset v(RST) v(CLK) tr_vin_cm tr_vin_diff tr_vout_cm tr_vout_diff tr_rld

        destroy $curplot

    end
end

