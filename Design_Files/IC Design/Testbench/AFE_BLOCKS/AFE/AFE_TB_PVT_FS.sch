C {lab_wire.sym} 400 -800 0 0 {name=p17 sig_type=std_logic lab=BODY}
C {lab_wire.sym} 1600 -1000 0 0 {name=p22 sig_type=std_logic lab=AVDD}
C {lab_wire.sym} 1600 -600 0 0 {name=p24 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 2320 -600 0 0 {name=p25 sig_type=std_logic lab=FDBUF_OUTP}
C {lab_wire.sym} 1760 -600 0 0 {name=p26 sig_type=std_logic lab=BPINT}
C {lab_wire.sym} 2000 -600 0 0 {name=p27 sig_type=std_logic lab=LPF_OUTP}
C {lab_wire.sym} 2160 -600 0 0 {name=p28 sig_type=std_logic lab=PGA_OUTP}
C {lab_wire.sym} 1840 -600 0 0 {name=p29 sig_type=std_logic lab=INA_OUTP}
C {lab_wire.sym} 1920 -540 0 0 {name=p30 sig_type=std_logic lab=INA_OUTN}
C {lab_wire.sym} 2080 -540 0 0 {name=p31 sig_type=std_logic lab=LPF_OUTN}
C {lab_wire.sym} 1400 -840 0 0 {name=p32 sig_type=std_logic lab=INP}
C {lab_wire.sym} 1760 -1000 0 0 {name=p33 sig_type=std_logic lab=BPEXT}
C {lab_wire.sym} 2400 -540 0 0 {name=p34 sig_type=std_logic lab=FDBUF_OUTN}
C {lab_wire.sym} 2240 -540 0 0 {name=p35 sig_type=std_logic lab=PGA_OUTN}
C {lab_wire.sym} 1400 -760 0 0 {name=p38 sig_type=std_logic lab=INN}
C {lab_wire.sym} 3000 -840 0 1 {name=p45 sig_type=std_logic lab=OUTP}
C {lab_wire.sym} 2480 -600 0 0 {name=p46 sig_type=std_logic lab=REF}
C {lab_wire.sym} 3000 -760 0 1 {name=p47 sig_type=std_logic lab=OUTN}
C {lab_wire.sym} 1680 -1000 0 0 {name=p48 sig_type=std_logic lab=S1}
C {lab_wire.sym} 2720 -600 0 0 {name=p49 sig_type=std_logic lab=SEOP}
C {lab_wire.sym} 2640 -600 0 0 {name=p50 sig_type=std_logic lab=IB}
C {lab_wire.sym} 1680 -600 0 0 {name=p51 sig_type=std_logic lab=S0}
C {lab_wire.sym} 2800 -600 0 0 {name=p52 sig_type=std_logic lab=SEON}
C {lab_wire.sym} 2560 -600 0 0 {name=p53 sig_type=std_logic lab=RLD}
C {lab_wire.sym} 80 -400 0 0 {name=p54 sig_type=std_logic lab=AVDD}
C {lab_wire.sym} 80 -320 2 0 {name=p55 sig_type=std_logic lab=0}
C {lab_wire.sym} 80 -260 0 0 {name=p56 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 80 -180 2 0 {name=p57 sig_type=std_logic lab=0}
C {lab_wire.sym} 640 -400 0 0 {name=p58 sig_type=std_logic lab=REF}
C {lab_wire.sym} 640 -320 2 0 {name=p59 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 640 -260 0 0 {name=p60 sig_type=std_logic lab=SEL_INT}
C {lab_wire.sym} 640 -180 2 0 {name=p61 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 1200 -400 0 0 {name=p62 sig_type=std_logic lab=CMSRC}
C {lab_wire.sym} 1200 -320 2 0 {name=p63 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 1200 -260 0 0 {name=p64 sig_type=std_logic lab=VDIFF}
C {lab_wire.sym} 1200 -180 2 0 {name=p65 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 1760 -400 0 0 {name=p66 sig_type=std_logic lab=BPEXT}
C {lab_wire.sym} 1760 -320 2 0 {name=p67 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 1760 -260 0 0 {name=p68 sig_type=std_logic lab=G1}
C {lab_wire.sym} 1760 -180 2 0 {name=p69 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 2320 -260 0 0 {name=p70 sig_type=std_logic lab=G0}
C {lab_wire.sym} 2320 -180 2 0 {name=p71 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 2320 -400 0 0 {name=p72 sig_type=std_logic lab=S1}
C {lab_wire.sym} 2320 -320 2 0 {name=p73 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 2880 -400 0 0 {name=p74 sig_type=std_logic lab=S0}
C {lab_wire.sym} 2880 -320 2 0 {name=p75 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 3160 -840 0 0 {name=p76 sig_type=std_logic lab=OUTP}
C {lab_wire.sym} 3160 -1000 0 0 {name=p77 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 3160 -760 0 0 {name=p78 sig_type=std_logic lab=OUTN}
C {lab_wire.sym} 3160 -600 0 0 {name=p79 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 2880 -280 0 0 {name=p80 sig_type=std_logic lab=IB}
C {lab_wire.sym} 2880 -140 2 0 {name=p81 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 2800 -230 0 0 {name=p82 sig_type=std_logic lab=AVDD}
C {lab_wire.sym} 2800 -190 0 0 {name=p83 sig_type=std_logic lab=AGND}
C {devices/code_shown.sym} 80 90 0 0 {name=MODELS
only_toplevel=true
format="tcleval( @value )"
value="
* \{MODELS_START\}
.include $::180MCU_MODELS/design.ngspice
.param sw_stat_global=0
.param sw_stat_mismatch=0
.lib $::180MCU_MODELS/sm141064.ngspice fs
.lib $::180MCU_MODELS/sm141064.ngspice res_typical
.lib $::180MCU_MODELS/sm141064.ngspice mimcap_typical
.lib $::180MCU_MODELS/sm141064.ngspice cap_mim
.lib $::180MCU_MODELS/sm141064.ngspice bjt_typical
.csparam PROC_ID=3
* \{MODELS_END\}
"}
C {devices/code_shown.sym} 640 90 0 0 {name=SETUP
only_toplevel=true
value="

* \{SETUP_START\}
.param VDD_SET=3.3
.param TEMP_SET=27
.param CL_SET=60p
.param RELECP_SET=51k
.param RELECN_SET=51k
.param CELEC_SET=47n
.param CCOUP_SET=100p
.param CRETURN_SET=100p
.param ELECTRODE_P_OFFSET_SET=0
.param ELECTRODE_N_OFFSET_SET=0
.param RBYP_P_SET=1e15
.param RBYP_N_SET=1e15
.param RBYP_R_SET=1e15
.csparam MC_RUNS=200
* Target final differential sine amplitude = 1 V peak, f0 = 10 Hz.
* Coherent FFT: settle 0.2 s; record 0.4 s (4 cycles); N=4096.
* Export resampled record including endpoint; FFT reader must discard last point.
.temp \{TEMP_SET\}
.options gmin=1e-12 rshunt=1e12 method=gear
* \{SETUP_END\}
"}
C {devices/code_shown.sym} 1200 90 0 0 {name=NGSPICE
only_toplevel=true
value="

* \{MEAS_START\}
.control
destroy all
set noaskquit
set wr_singlescale
unset wr_vecnames
option klu
option numdgt=15
option method=gear
option maxord=2
option plotwinsize=0

if $&PROC_ID = 0
setcs proc=\"NOM\"
end
if $&PROC_ID = 1
setcs proc=\"FF\"
end
if $&PROC_ID = 2
setcs proc=\"SS\"
end
if $&PROC_ID = 3
setcs proc=\"FS\"
end
if $&PROC_ID = 4
setcs proc=\"SF\"
end
setcs outdir=\"/foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/AFE/\{$proc\}.Result_txt\"
shell mkdir -p \{$outdir\}
* Existing exports are not removed: an interrupted rerun must not erase results.
foreach ecode 0 1 2 3 4 5 6 7 8
set env=nom
set vddval=3.3
set tval=27
if $ecode = 1
set env=vl
set vddval=3
set tval=27
end
if $ecode = 2
set env=vh
set vddval=3.6
set tval=27
end
if $ecode = 3
set env=tl
set vddval=3.3
set tval=-40
end
if $ecode = 4
set env=th
set vddval=3.3
set tval=125
end
if $ecode = 5
set env=vltl
set vddval=3
set tval=-40
end
if $ecode = 6
set env=vlth
set vddval=3
set tval=125
end
if $ecode = 7
set env=vhtl
set vddval=3.6
set tval=-40
end
if $ecode = 8
set env=vhth
set vddval=3.6
set tval=125
end
alterparam VDD_SET=$vddval
alterparam TEMP_SET=$tval
reset
save all
save v(AVDD) v(AGND) v(REF) v(VDIFF) v(INP) v(INN) v(OUTP) v(OUTN) v(BODY) vavdd#branch
echo AFE PVT: $proc $env

* Identical measurement body in PVT and MC. No reset/mc_source inside gain loop.

* Normal performance always uses internal signal paths.
alter VCINA 0
alter VCLPF 0
alter VCPGA 0
alter VCFDBUF 0
alter @VXINA[acmag]=0
alter @VXLPF[acmag]=0
alter @VXPGA[acmag]=0
alter @VXFDBUF[acmag]=0

foreach gcode 0 1 2 3
alter VG1 0
alter VG0 0
if $gcode = 0
set gtag=g2
set gainval=480
end
if $gcode = 1
set gtag=g4
set gainval=960
alter VG0 1
end
if $gcode = 2
set gtag=g8
set gainval=1920
alter VG1 1
end
if $gcode = 3
set gtag=g16
set gainval=3840
alter VG1 1
alter VG0 1
end
setcs casefile=\{$outdir\}/\{$proc\}.\{$gtag\}_\{$env\}
alter @VDIFF[sin] = [ 0 0 10 ]
alter @VDIFF[acmag]=0
alter @VSTD[sin] = [ 0 0 60 ]
alter @VSTD[acmag]=0
alter @VAVDD[acmag]=0
alter LRLD_ISO 1p
op
let idx=0
let vdd=v(AVDD)-v(AGND)
let idd=abs(vavdd#branch)
let power=vdd*idd
let outcm=0.5*(v(OUTP)+v(OUTN))-v(AGND)
let cmerr=outcm-v(REF)+v(AGND)
let outdiff=v(OUTP)-v(OUTN)
let incm=0.5*(v(INP)+v(INN))-v(AGND)
setscale idx
wrdata \{$casefile\}.op.txt vdd idd power cmerr outcm outdiff incm
destroy all

* Final differential gain includes electrode loading and integrated selectors.
alter @VDIFF[acmag]=1
ac dec 80 0.01 1Meg
let vin=v(VDIFF)-v(AGND)
let vout=v(OUTP)-v(OUTN)
let ir=real(vin)
let ii=imag(vin)
let yr=real(vout)
let yi=imag(vout)
wrdata \{$casefile\}.diff_ac.txt ir ii yr yi
destroy all

* Intrinsic chain CMRR: ideal equal common-mode drive at both electrodes.
* Body interference/RLD integration is measured separately below.
alter @VDIFF[acmag]=0
alter @VSTD[acmag]=1
ac dec 80 0.01 10k
let vin=0.5*(v(INP)+v(INN))-v(AGND)
let vout=v(OUTP)-v(OUTN)
let ir=real(vin)
let ii=imag(vin)
let yr=real(vout)
let yi=imag(vout)
wrdata \{$casefile\}.cmrr_ac.txt ir ii yr yi
destroy all
alter @VSTD[acmag]=0

alter @VAVDD[acmag]=1
ac dec 80 0.01 10k
let vsup=v(AVDD)-v(AGND)
let vout=v(OUTP)-v(OUTN)
let ir=real(vsup)
let ii=imag(vsup)
let yr=real(vout)
let yi=imag(vout)
wrdata \{$casefile\}.psrrp_ac.txt ir ii yr yi
destroy all
alter @VAVDD[acmag]=0

alter @VDIFF[acmag]=1
option sparse
noise v(OUTP,OUTN) VDIFF dec 100 0.01 1k
setplot previous
wrdata \{$casefile\}.noise.txt onoise_spectrum inoise_spectrum
destroy all
option klu

* No offset cancellation: saturation/clipping is a real integration result.
* Scale source amplitude to 1 V differential output peak at nominal gain.
let inputpk=1/$gainval
set amp=$&inputpk
alter @VDIFF[acmag]=0
alter @VDIFF[sin] = [ 0 $amp 10 ]
tran 97.65625u 600m 200m 97.65625u
linearize v(VDIFF) v(OUTP) v(OUTN) v(REF) v(AVDD)
let vd=v(VDIFF)
let op=v(OUTP)
let on=v(OUTN)
let ref=v(REF)
let vdd=v(AVDD)
wrdata \{$casefile\}.signal_tran.txt vd op on ref vdd
destroy all
alter @VDIFF[sin] = [ 0 0 10 ]

* RLD integration, same G2 and sample/corner as main measurements.
if $gcode = 0
foreach rcode 0 1
set rstate=on
alter LRLD_ISO 1p
if $rcode = 0
set rstate=off
alter LRLD_ISO 1e12
end
alter @VSTD[acmag]=1
ac dec 80 1 1k
let b=v(BODY)-v(AGND)
let incm=0.5*(v(INP)+v(INN))-v(AGND)
let yr=real(incm)
let yi=imag(incm)
let br=real(b)
let bi=imag(b)
* Unit source response; multiply by 20 Vrms for source-referenced CM residual.
wrdata \{$casefile\}.rld_\{$rstate\}_ac.txt yr yi br bi
destroy all
alter @VSTD[acmag]=0
* 20 Vrms mains source through 100 pF coupling, 60 Hz.
alter @VSTD[sin] = [ 0 28.2842712475 60 ]
tran 100u 400m 200m 100u
linearize v(BODY) v(INP) v(INN) v(OUTP) v(OUTN)
let body=v(BODY)
let incm=0.5*(v(INP)+v(INN))
let outdiff=v(OUTP)-v(OUTN)
wrdata \{$casefile\}.rld_\{$rstate\}_tran.txt body incm outdiff
destroy all
alter @VSTD[sin] = [ 0 0 60 ]
end
alter LRLD_ISO 1p
end
end

* SELECTOR INTEGRATION - G2, same corner/statistical realization.
* Independent 10 Hz main input and 25 Hz external input responses.
* EXT paths bypass upstream blocks: G2 targets are 2, 2, 1, 1 V/V.
alter VG1 0
alter VG0 0
alter LRLD_ISO 1p
alter @VDIFF[sin] = [ 0 0 10 ]
alter @VSTD[sin] = [ 0 0 60 ]
alter @VSTD[acmag]=0
alter @VAVDD[acmag]=0
foreach pcode 0 1 2 3
if $pcode = 0
set path=ina
set xtarget=2
end
if $pcode = 1
set path=lpf
set xtarget=2
end
if $pcode = 2
set path=pga
set xtarget=1
end
if $pcode = 3
set path=fdbuf
set xtarget=1
end
foreach scode 0 1
set selection=int
if $scode = 1
set selection=ext
end
alter VCINA 0
alter VCLPF 0
alter VCPGA 0
alter VCFDBUF 0
if $scode = 1
if $pcode = 0
alter VCINA 1
end
if $pcode = 1
alter VCLPF 1
end
if $pcode = 2
alter VCPGA 1
end
if $pcode = 3
alter VCFDBUF 1
end
end
alter @VDIFF[acmag]=0
alter @VXINA[acmag]=0
alter @VXLPF[acmag]=0
alter @VXPGA[acmag]=0
alter @VXFDBUF[acmag]=0
setcs sel_file=\{$outdir\}/\{$proc\}.selector_\{$path\}_\{$selection\}_\{$env\}
op
let idx=0
let vdd=v(AVDD)-v(AGND)
let ref=v(REF)-v(AGND)
let op=v(OUTP)-v(AGND)
let on=v(OUTN)-v(AGND)
let mainpk=0.2/480
let extpk=0.3/$xtarget
setscale idx
wrdata \{$sel_file\}.op.txt vdd ref op on mainpk extpk
destroy all

* Main input transfer; actual state determines whether it is selected.
alter @VDIFF[acmag]=1
ac lin 1 10 10
let pr=real(v(OUTP)-v(AGND))
let pi=imag(v(OUTP)-v(AGND))
let nr=real(v(OUTN)-v(AGND))
let ni=imag(v(OUTN)-v(AGND))
wrdata \{$sel_file\}.main_ac.txt pr pi nr ni
destroy all
alter @VDIFF[acmag]=0

* Excite only the external pair belonging to this selector.
if $pcode = 0
alter @VXINA[acmag]=1
end
if $pcode = 1
alter @VXLPF[acmag]=1
end
if $pcode = 2
alter @VXPGA[acmag]=1
end
if $pcode = 3
alter @VXFDBUF[acmag]=1
end
ac lin 1 25 25
let pr=real(v(OUTP)-v(AGND))
let pi=imag(v(OUTP)-v(AGND))
let nr=real(v(OUTN)-v(AGND))
let ni=imag(v(OUTN)-v(AGND))
wrdata \{$sel_file\}.ext_ac.txt pr pi nr ni
destroy all
end
end
alter VCINA 0
alter VCLPF 0
alter VCPGA 0
alter VCFDBUF 0
alter @VXINA[acmag]=0
alter @VXLPF[acmag]=0
alter @VXPGA[acmag]=0
alter @VXFDBUF[acmag]=0

end
quit
.endc
* \{MEAS_END\}
"}
