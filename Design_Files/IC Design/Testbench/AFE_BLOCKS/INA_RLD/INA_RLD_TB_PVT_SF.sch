C {title.sym} 160 -40 0 0 {name=l1 author="Yi-Hsiang Wei"}
C {devices/code_shown.sym} 80 90 0 0 {name=MODELS
only_toplevel=true
format="tcleval( @value )"
value="
* \{MODELS_START\}
.include $::180MCU_MODELS/design.ngspice

.param sw_stat_global=0
.param sw_stat_mismatch=0

.param ECG_AMP_SET=0.5m

* SF

.lib $::180MCU_MODELS/sm141064.ngspice sf
.lib $::180MCU_MODELS/sm141064.ngspice res_typical
.lib $::180MCU_MODELS/sm141064.ngspice mimcap_typical
.lib $::180MCU_MODELS/sm141064.ngspice cap_mim
.lib $::180MCU_MODELS/sm141064.ngspice bjt_typical

.csparam PROC_ID=4
* \{MODELS_END\}
"}
C {devices/code_shown.sym} 640 90 0 0 {name=SETUP
only_toplevel=true
value="
* \{SETUP_START\}
.param VDD_SET=3.3
.param TEMP_SET=27
.param VCM_SET=\{VDD_SET/2\}
.param VREF_SET=\{VDD_SET/2\}

.param CL_SET=10p

.param ECG_FREQ_SET=10
.param CM_SOURCE_RMS_SET=20
.param CM_SOURCE_PK_SET=\{sqrt(2)*CM_SOURCE_RMS_SET\}
.param CM_FREQ_SET=60
.param CM_COUPLING_SET=100p
.param CM_RETURN_SET=100p
.param ELECTRODE_P_OFFSET_SET=0
.param ELECTRODE_N_OFFSET_SET=0
.param RBYP_P_SET=1e15
.param RBYP_N_SET=1e15
.param RBYP_R_SET=1e15

.param RELECP_SET=51k
.param RELECN_SET=51k
.param CELECP_SET=47n
.param CELECN_SET=47n

.param RRLD_SAFE_SET=1Meg
.param LRLD_ISO_SET=1p
.param RELECRLD_SET=51k
.param CELECRLD_SET=47n

.param SEL_TRAN_HIGH_SET=0
.param SEL_SWITCH_TIME_SET=200m
.param EXT_TRAN_AMP_SET=0
.param EXT_TRAN_FREQ_SET=25

.temp \{TEMP_SET\}

.options gmin=1e-12
.options rshunt=1e12
.options method=gear
* \{SETUP_END\}
"}
C {devices/code_shown.sym} 1200 90 0 0 {name=NGSPICE
only_toplevel=true
value="
* \{MEAS_START\}
.control

destroy all

set noaskquit
set wr_singlescale
unset wr_vecnames

option klu
option numdgt=15
option method=gear
option maxord=2
option plotwinsize=0

if $&PROC_ID = 0
set proc=NOM
else
if $&PROC_ID = 1
set proc=FF
else
if $&PROC_ID = 2
set proc=SS
else
if $&PROC_ID = 3
set proc=FS
else
set proc=SF
end
end
end
end

shell mkdir -p /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt
shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.*.txt

foreach vddval 3.3 3.0 3.6
foreach tval 27 -40 125

if $vddval = 3.3
if $tval = 27
set env=nom
else
if $tval = -40
set env=tl
else
set env=th
end
end
else
if $vddval = 3.0
if $tval = 27
set env=vl
else
if $tval = -40
set env=vltl
else
set env=vlth
end
end
else
if $tval = 27
set env=vh
else
if $tval = -40
set env=vhtl
else
set env=vhth
end
end
end
end

alterparam VDD_SET=$vddval
alterparam TEMP_SET=$tval

reset

save all
save @m.xmbse0.m0[id]
save @m.xmbse1.m0[id]
save @m.xmbse2.m0[id]
save @m.xmbfdc.m0[id]
save @m.xmbcmfb.m0[id]

foreach emode 0

* NOMINAL ELECTRODE MODEL
set elec=bal
alter RELECP 51k
alter RELECN 51k
alter CELECP 47n
alter CELECN 47n
alter RELECRLD 51k
alter CELECRLD 47n
alter RBYP_P 1e15
alter RBYP_N 1e15
alter RBYP_R 1e15


* OFFSET

alter RRLD_SAFE 1Meg
alter @VSEL[DC]=0
alter @VDIFF[DC]=0

alter @VDIFF[ACMAG]=0
alter @VSTD[ACMAG]=0
alter @VLOOP[ACMAG]=0
alter @VEXTDIFF[ACMAG]=0
alter @VREF[ACMAG]=0
alter @VAVDD[ACMAG]=0
alter @VAVSS[ACMAG]=0

dc VDIFF -3m 3m 50u

let ina_out_diff=v(INA_OUTP)-v(INA_OUTN)

meas dc vos_meas when ina_out_diff=0 cross=1

set vos_val=$&vos_meas

echo $vos_val > /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.vos_\{$env\}_\{$elec\}.txt

destroy all

alter @VDIFF[DC]=$vos_val


* OP

alter RRLD_SAFE 1Meg
alter @VSEL[DC]=0

alter @VDIFF[ACMAG]=0
alter @VSTD[ACMAG]=0
alter @VLOOP[ACMAG]=0
alter @VEXTDIFF[ACMAG]=0
alter @VREF[ACMAG]=0
alter @VAVDD[ACMAG]=0
alter @VAVSS[ACMAG]=0

op

let vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
let vin_diff=v(INP)-v(INN)
let se_cm=0.5*(v(SEOP)+v(SEON))-v(AGND)
let se_diff=v(SEOP)-v(SEON)
let ina_out_cm=0.5*(v(INA_OUTP)+v(INA_OUTN))-v(AGND)
let ina_out_diff=v(INA_OUTP)-v(INA_OUTN)
let out_cm=0.5*(v(OUTP)+v(OUTN))-v(AGND)
let out_diff=v(OUTP)-v(OUTN)

let idd_total=abs(vavdd#branch)
let power_total=(v(AVDD)-v(AGND))*idd_total
let irld=abs(vloop#branch)

let ibse0=abs(@m.xmbse0.m0[id])
let ibse1=abs(@m.xmbse1.m0[id])
let ibse2=abs(@m.xmbse2.m0[id])
let ibfdc=abs(@m.xmbfdc.m0[id])
let ibcmfb=abs(@m.xmbcmfb.m0[id])

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.op_\{$env\}_\{$elec\}.txt v(AVDD) v(REF) v(BP) vin_cm vin_diff v(SEOP) v(SEON) se_cm se_diff v(INA_OUTP) v(INA_OUTN) ina_out_cm ina_out_diff v(OUTP) v(OUTN) out_cm out_diff v(RLD) v(BODY) irld idd_total power_total ibse0 ibse1 ibse2 ibfdc ibcmfb

destroy all


* INA AC

alter RRLD_SAFE 1Meg
alter @VSEL[DC]=0

alter @VDIFF[ACMAG]=1
alter @VDIFF[ACPHASE]=0
alter @VSTD[ACMAG]=0
alter @VLOOP[ACMAG]=0
alter @VEXTDIFF[ACMAG]=0
alter @VREF[ACMAG]=0
alter @VAVDD[ACMAG]=0
alter @VAVSS[ACMAG]=0

ac dec 50 0.01 10Meg

let vin_diff=v(INP)-v(INN)
let se_diff=v(SEOP)-v(SEON)
let ina_out_diff=v(INA_OUTP)-v(INA_OUTN)
let out_diff=v(OUTP)-v(OUTN)

let vin_diff_real=real(vin_diff)
let vin_diff_imag=imag(vin_diff)

let se_diff_real=real(se_diff)
let se_diff_imag=imag(se_diff)

let ina_out_diff_real=real(ina_out_diff)
let ina_out_diff_imag=imag(ina_out_diff)

let out_diff_real=real(out_diff)
let out_diff_imag=imag(out_diff)

let rld_real=real(v(RLD))
let rld_imag=imag(v(RLD))

setscale frequency

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.diff_ac_\{$env\}_\{$elec\}.txt vin_diff_real vin_diff_imag se_diff_real se_diff_imag ina_out_diff_real ina_out_diff_imag out_diff_real out_diff_imag rld_real rld_imag

destroy all


* RLD OFF

* Keep the DC bias; isolate the RLD path in AC.
alter RRLD_SAFE 1Meg
alter LRLD_ISO 1e12
alter @VSEL[DC]=0

alter @VDIFF[ACMAG]=0
alter @VSTD[ACMAG]=1
alter @VSTD[ACPHASE]=0
alter @VLOOP[ACMAG]=0
alter @VEXTDIFF[ACMAG]=0
alter @VREF[ACMAG]=0
alter @VAVDD[ACMAG]=0
alter @VAVSS[ACMAG]=0

op

let rld_off_vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
let rld_off_body=v(BODY)-v(AGND)

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.rld_off_op_\{$env\}_\{$elec\}.txt rld_off_vin_cm rld_off_body v(INP) v(INN)

destroy all

ac dec 50 0.01 100k

let vcm_src=v(CMSRC)-v(AGND)
let body=v(BODY)-v(AGND)
let vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
let se_cm=0.5*(v(SEOP)+v(SEON))-v(AGND)
let ina_out_diff=v(INA_OUTP)-v(INA_OUTN)
let out_diff=v(OUTP)-v(OUTN)

let vcm_src_real=real(vcm_src)
let vcm_src_imag=imag(vcm_src)

let body_real=real(body)
let body_imag=imag(body)

let vin_cm_real=real(vin_cm)
let vin_cm_imag=imag(vin_cm)

let se_cm_real=real(se_cm)
let se_cm_imag=imag(se_cm)

let ina_out_diff_real=real(ina_out_diff)
let ina_out_diff_imag=imag(ina_out_diff)

let out_diff_real=real(out_diff)
let out_diff_imag=imag(out_diff)

let rld_real=real(v(RLD))
let rld_imag=imag(v(RLD))

setscale frequency

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.cm_off_ac_\{$env\}_\{$elec\}.txt vcm_src_real vcm_src_imag body_real body_imag vin_cm_real vin_cm_imag se_cm_real se_cm_imag out_diff_real out_diff_imag rld_real rld_imag

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.ina_cmrr_ac_\{$env\}_\{$elec\}.txt vin_cm_real vin_cm_imag ina_out_diff_real ina_out_diff_imag

destroy all


* RLD ON

alter RRLD_SAFE 1Meg
alter LRLD_ISO 1p
alter @VSEL[DC]=0

alter @VDIFF[ACMAG]=0
alter @VSTD[ACMAG]=1
alter @VSTD[ACPHASE]=0
alter @VLOOP[ACMAG]=0
alter @VEXTDIFF[ACMAG]=0
alter @VREF[ACMAG]=0
alter @VAVDD[ACMAG]=0
alter @VAVSS[ACMAG]=0

ac dec 50 0.01 10k

let vcm_src=v(CMSRC)-v(AGND)
let body=v(BODY)-v(AGND)
let vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
let se_cm=0.5*(v(SEOP)+v(SEON))-v(AGND)
let out_diff=v(OUTP)-v(OUTN)

let vcm_src_real=real(vcm_src)
let vcm_src_imag=imag(vcm_src)

let body_real=real(body)
let body_imag=imag(body)

let vin_cm_real=real(vin_cm)
let vin_cm_imag=imag(vin_cm)

let se_cm_real=real(se_cm)
let se_cm_imag=imag(se_cm)

let out_diff_real=real(out_diff)
let out_diff_imag=imag(out_diff)

let rld_real=real(v(RLD))
let rld_imag=imag(v(RLD))

setscale frequency

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.cm_on_ac_\{$env\}_\{$elec\}.txt vcm_src_real vcm_src_imag body_real body_imag vin_cm_real vin_cm_imag se_cm_real se_cm_imag out_diff_real out_diff_imag rld_real rld_imag

destroy all


* PSRR+

alter RRLD_SAFE 1Meg
alter @VSEL[DC]=0

alter @VDIFF[ACMAG]=0
alter @VSTD[ACMAG]=0
alter @VLOOP[ACMAG]=0
alter @VEXTDIFF[ACMAG]=0
alter @VREF[ACMAG]=0

alter @VAVDD[ACMAG]=1
alter @VAVDD[ACPHASE]=0
alter @VAVSS[ACMAG]=0

ac dec 50 0.01 100k

let vsup=v(AVDD)-v(AGND)
let ina_out_diff=v(INA_OUTP)-v(INA_OUTN)
let out_diff=v(OUTP)-v(OUTN)

let vsup_real=real(vsup)
let vsup_imag=imag(vsup)

let ina_out_diff_real=real(ina_out_diff)
let ina_out_diff_imag=imag(ina_out_diff)

let out_diff_real=real(out_diff)
let out_diff_imag=imag(out_diff)

setscale frequency

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.psrrp_ac_\{$env\}_\{$elec\}.txt vsup_real vsup_imag ina_out_diff_real ina_out_diff_imag out_diff_real out_diff_imag

destroy all


* PSRR-

alter RRLD_SAFE 1Meg
alter @VSEL[DC]=0

alter @VDIFF[ACMAG]=0
alter @VSTD[ACMAG]=0
alter @VLOOP[ACMAG]=0
alter @VEXTDIFF[ACMAG]=0
alter @VREF[ACMAG]=0

alter @VAVDD[ACMAG]=0
alter @VAVSS[ACMAG]=1
alter @VAVSS[ACPHASE]=0

ac dec 50 0.01 100k

let vsup=v(AVDD)-v(AGND)
let ina_out_diff=v(INA_OUTP)-v(INA_OUTN)
let out_diff=v(OUTP)-v(OUTN)

let vsup_real=real(vsup)
let vsup_imag=imag(vsup)

let ina_out_diff_real=real(ina_out_diff)
let ina_out_diff_imag=imag(ina_out_diff)

let out_diff_real=real(out_diff)
let out_diff_imag=imag(out_diff)

setscale frequency

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.psrrn_ac_\{$env\}_\{$elec\}.txt vsup_real vsup_imag ina_out_diff_real ina_out_diff_imag out_diff_real out_diff_imag

destroy all


* RLD LOOP

alter RRLD_SAFE 1Meg
alter LRLD_ISO 1p
alter @VSEL[DC]=0

alter @VDIFF[ACMAG]=0
alter @VSTD[ACMAG]=0
alter @VLOOP[ACMAG]=1
alter @VLOOP[ACPHASE]=0
alter @VEXTDIFF[ACMAG]=0
alter @VREF[ACMAG]=0
alter @VAVDD[ACMAG]=0
alter @VAVSS[ACMAG]=0

ac dec 50 0.01 100k

let loop_in=v(RLD_DRV)-v(AGND)
let loop_out=v(RLD)-v(AGND)
let body=v(BODY)-v(AGND)
let vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
let se_cm=0.5*(v(SEOP)+v(SEON))-v(AGND)

let loop_in_real=real(loop_in)
let loop_in_imag=imag(loop_in)

let loop_out_real=real(loop_out)
let loop_out_imag=imag(loop_out)

let body_real=real(body)
let body_imag=imag(body)

let vin_cm_real=real(vin_cm)
let vin_cm_imag=imag(vin_cm)

let se_cm_real=real(se_cm)
let se_cm_imag=imag(se_cm)

setscale frequency

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.rld_loop_ac_\{$env\}_\{$elec\}.txt loop_in_real loop_in_imag loop_out_real loop_out_imag body_real body_imag vin_cm_real vin_cm_imag se_cm_real se_cm_imag

destroy all


* NOISE

alter RRLD_SAFE 1Meg
alter @VSEL[DC]=0

alter @VDIFF[ACMAG]=1
alter @VDIFF[ACPHASE]=0
alter @VSTD[ACMAG]=0
alter @VLOOP[ACMAG]=0
alter @VEXTDIFF[ACMAG]=0
alter @VREF[ACMAG]=0
alter @VAVDD[ACMAG]=0
alter @VAVSS[ACMAG]=0

option sparse

noise v(OUTP,OUTN) VDIFF dec 50 0.05 500

setplot previous
setscale frequency

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.noise_\{$env\}_\{$elec\}.txt onoise_spectrum inoise_spectrum

destroy all


* INA VTC

* Balanced electrodes, RLD ON, internal INA path.
alter RELECP 51k
alter RELECN 51k
alter CELECP 47n
alter CELECN 47n
alter RELECRLD 51k
alter CELECRLD 47n
alter RBYP_P 1e15
alter RBYP_N 1e15
alter RBYP_R 1e15
alter RRLD_SAFE 1Meg
alter LRLD_ISO 1p
alter @VSEL[DC]=0

* No AC excitation.
alter @VDIFF[ACMAG]=0
alter @VSTD[ACMAG]=0
alter @VLOOP[ACMAG]=0
alter @VEXTDIFF[ACMAG]=0
alter @VREF[ACMAG]=0
alter @VAVDD[ACMAG]=0
alter @VAVSS[ACMAG]=0

* Sweep beyond the required ECG plus offset range.
dc VDIFF -20m 20m 50u

let vin_diff=v(INP)-v(INN)
let ina_outp=v(INA_OUTP)-v(AGND)
let ina_outn=v(INA_OUTN)-v(AGND)
let ina_out_cm=0.5*(v(INA_OUTP)+v(INA_OUTN))-v(AGND)
let ina_out_diff=v(INA_OUTP)-v(INA_OUTN)

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.vtc_\{$env\}_\{$elec\}.txt vin_diff ina_outp ina_outn ina_out_cm ina_out_diff

destroy all


* THD AT 60 HZ

* 5 mVpp (2.5 mV peak) differential input at 60 Hz.
alterparam ECG_AMP_SET=2.5m
alterparam ECG_FREQ_SET=60
alterparam CM_SOURCE_RMS_SET=0
alterparam ELECTRODE_P_OFFSET_SET=0
alterparam ELECTRODE_N_OFFSET_SET=0

reset

save v(INP) v(INN)
save v(INA_OUTP) v(INA_OUTN)
save v(OUTP) v(OUTN)

* Balanced electrodes, RLD ON, internal INA path.
alter RELECP 51k
alter RELECN 51k
alter CELECP 47n
alter CELECN 47n
alter RELECRLD 51k
alter CELECRLD 47n
alter RBYP_P 1e15
alter RBYP_N 1e15
alter RBYP_R 1e15
alter RRLD_SAFE 1Meg
alter LRLD_ISO 1p
alter @VSEL[DC]=0
alter @VDIFF[DC]=0

* 100 ms settling and 10 measured cycles.
tran 50u 266.666667m 100m

let vin_diff=v(INP)-v(INN)
let ina_out_diff=v(INA_OUTP)-v(INA_OUTN)
let out_diff=v(OUTP)-v(OUTN)

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.thd_60_\{$env\}_\{$elec\}.txt vin_diff ina_out_diff out_diff

destroy all


* Restore normal PVT stimulus.
alterparam ECG_AMP_SET=0.5m
alterparam ECG_FREQ_SET=10
alterparam CM_SOURCE_RMS_SET=20


end

end
end


* STD CMR - ACTIVE LEADS (FULL 3 x 3 VDD/TEMP MATRIX)

foreach rti_vdd 3.3 3.0 3.6
foreach rti_temp 27 -40 125

if $rti_vdd = 3.3
if $rti_temp = 27
set env=nom
else
if $rti_temp = -40
set env=tl
else
set env=th
end
end
else
if $rti_vdd = 3.0
if $rti_temp = 27
set env=vl
else
if $rti_temp = -40
set env=vltl
else
set env=vlth
end
end
else
if $rti_temp = 27
set env=vh
else
if $rti_temp = -40
set env=vhtl
else
set env=vhth
end
end
end
end

alterparam VDD_SET=$rti_vdd
alterparam TEMP_SET=$rti_temp
alterparam ECG_AMP_SET=0
alterparam CM_SOURCE_RMS_SET=20
alterparam CM_FREQ_SET=60
alterparam ELECTRODE_P_OFFSET_SET=0
alterparam ELECTRODE_N_OFFSET_SET=0

reset
save all

alter RRLD_SAFE 1Meg
alter LRLD_ISO 1p
alter @VSEL[DC]=0
alter RELECP 51k
alter CELECP 47n
alter RELECN 51k
alter CELECN 47n
alter RELECRLD 51k
alter CELECRLD 47n
alter RBYP_P 1e15
alter RBYP_N 1e15
alter RBYP_R 1e15

* BAL

tran 200u 500m

let vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
let vin_diff=v(INP)-v(INN)
let out_diff=v(OUTP)-v(OUTN)

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.std_bal_\{$env\}.txt v(CMSRC) v(BODY) vin_cm vin_diff out_diff v(RLD)

destroy all

* MIS-P

alter RBYP_P 1
alter RBYP_N 1e15
alter RBYP_R 1e15

tran 200u 500m

let vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
let vin_diff=v(INP)-v(INN)
let out_diff=v(OUTP)-v(OUTN)

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.std_misp_\{$env\}.txt v(CMSRC) v(BODY) vin_cm vin_diff out_diff v(RLD)

destroy all

* MIS-N

alter RBYP_P 1e15
alter RBYP_N 1
alter RBYP_R 1e15

tran 200u 500m

let vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
let vin_diff=v(INP)-v(INN)
let out_diff=v(OUTP)-v(OUTN)

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.std_misn_\{$env\}.txt v(CMSRC) v(BODY) vin_cm vin_diff out_diff v(RLD)

destroy all

* MIS-RLD

alter RBYP_P 1e15
alter RBYP_N 1e15
alter RBYP_R 1

tran 200u 500m

let vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
let vin_diff=v(INP)-v(INN)
let out_diff=v(OUTP)-v(OUTN)

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.std_misrld_\{$env\}.txt v(CMSRC) v(BODY) vin_cm vin_diff out_diff v(RLD)

destroy all

end
end


* SEL NOM

if $&PROC_ID = 0

alterparam VDD_SET=3.3
alterparam TEMP_SET=27
alterparam ECG_AMP_SET=0.5m
alterparam CM_SOURCE_RMS_SET=0
alterparam ELECTRODE_P_OFFSET_SET=0
alterparam ELECTRODE_N_OFFSET_SET=0
alterparam SEL_TRAN_HIGH_SET=3.3
alterparam EXT_TRAN_AMP_SET=50m
alterparam EXT_TRAN_FREQ_SET=25

reset
save all

alter RELECP 51k
alter RELECN 51k
alter CELECP 47n
alter CELECN 47n
alter RELECRLD 51k
alter CELECRLD 47n
alter RRLD_SAFE 1Meg

alter @VDIFF[DC]=0
alter @VDIFF[ACMAG]=0
alter @VSTD[ACMAG]=0
alter @VLOOP[ACMAG]=0
alter @VEXTDIFF[ACMAG]=0
alter @VREF[ACMAG]=0
alter @VAVDD[ACMAG]=0
alter @VAVSS[ACMAG]=0

tran 50u 400m

let int_in_diff=v(INP)-v(INN)
let ext_in_diff=v(INA_EXTP)-v(INA_EXTN)
let out_diff=v(OUTP)-v(OUTN)

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE_BLOCKS/INA_RLD/\{$proc\}.Result_txt/\{$proc\}.sel_tran_nom.txt v(INA_SEL) int_in_diff ext_in_diff out_diff

destroy all

end

quit

.endc
* \{MEAS_END\}
"}
