C {lab_wire.sym} 160 -1640 0 0 {name=p32 sig_type=std_logic lab=AGND}
C {capa.sym} 1440 -1730 0 0 {name=CLP
m=1
value=\{CL_SET\}
footprint=1206
device="ceramic capacitor"}
C {lab_wire.sym} 1440 -1780 0 1 {name=p1 sig_type=std_logic lab=OUTP}
C {lab_wire.sym} 1440 -1680 2 0 {name=p2 sig_type=std_logic lab=AGND}
C {capa.sym} 1520 -1730 0 0 {name=CLN
m=1
value=\{CL_SET\}
footprint=1206
device="ceramic capacitor"}
