C {title.sym} 160 -40 0 0 {name=l1 author="Yi-Hsiang Wei"}
C {devices/code_shown.sym} 80 -1350 0 0 {name=MODELS
only_toplevel=true
format="tcleval( @value )"
value="
.include $::180MCU_MODELS/design.ngspice

.param sw_stat_global=1
.param sw_stat_mismatch=1

.param mc_skew=3
.param res_mc_skew=3
.param cap_mc_skew=3

.lib $::180MCU_MODELS/sm141064.ngspice statistical
.lib $::180MCU_MODELS/sm141064.ngspice res_typical
.lib $::180MCU_MODELS/sm141064.ngspice mimcap_typical
.lib $::180MCU_MODELS/sm141064.ngspice cap_mim
.lib $::180MCU_MODELS/sm141064.ngspice bjt_typical

.csparam PROC_ID=7
"}
C {devices/code_shown.sym} 80 -790 0 0 {name=SETUP
only_toplevel=true
value="
.param VDD_SET=3.3
.param TEMP_SET=27
.param VCM_SET=\{VDD_SET/2\}

.param CL_SET=10p

.param ECG_AMP_SET=0.5m
.param ECG_FREQ_SET=10
.param VCM_STEP_SET=300m

.param RBODY_SET=100Meg

.param RELECP_SET=100k
.param RELECN_SET=100k
.param CELECP_SET=100n
.param CELECN_SET=100n

.param RRLD_SAFE_SET=1Meg
.param RELECRLD_SET=100k
.param CELECRLD_SET=100n

.param SEL_TRAN_HIGH_SET=0
.param SEL_SWITCH_TIME_SET=200m
.param EXT_TRAN_AMP_SET=0
.param EXT_TRAN_FREQ_SET=25

.csparam MC_RUNS=200

.temp \{TEMP_SET\}

.options gmin=1e-12
.options rshunt=1e12
.options method=gear
"}
