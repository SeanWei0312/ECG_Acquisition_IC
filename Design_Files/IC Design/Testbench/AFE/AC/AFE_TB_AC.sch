C {title.sym} 160 -40 0 0 {name=l1 author="Yi-Hsiang Wei"}
C {vsource.sym} 160 -1070 0 0 {name=VAVDD value="dc \{VDD_SET\} ac 0" savecurrent=true}
C {gnd.sym} 160 -1040 0 0 {name=l5 lab=0}
C {lab_wire.sym} 760 -1760 0 0 {name=p4 sig_type=std_logic lab=INP}
C {lab_wire.sym} 760 -1640 0 0 {name=p6 sig_type=std_logic lab=INN}
C {devices/code_shown.sym} 80 -730 0 0 {name=MODELS only_toplevel=true
format="tcleval( @value )"
value="
.include $::180MCU_MODELS/design.ngspice
.lib $::180MCU_MODELS/sm141064.ngspice typical
.temp 27
.param VDD_SET=3.3
"}
C {devices/code_shown.sym} 80 -580 0 0 {name=SETUP only_toplevel=true
value="
.param VCM_SET=\{VDD_SET/2\}
.param VGCM_SET=\{VCM_SET*0.95\}
.param VCMDCOFFSET_SET=0
.param VDIFFDCOFFSET_SET=0

.options gmin=1e-12 rshunt=1e12 method=gear

.nodeset v(INP)=\{VCM_SET\} v(INN)=\{VCM_SET\}
.nodeset v(OUTP)=\{VCM_SET\} v(OUTN)=\{VCM_SET\}
.nodeset v(REF)=\{VCM_SET\}
.nodeset v(B)=2.3
"}
C {vsource.sym} 160 -930 0 0 {name=VAVSS value="dc 0 ac 0"         savecurrent=true}
C {gnd.sym} 160 -900 0 0 {name=l11 lab=0}
C {lab_wire.sym} 160 -980 0 0 {name=p8 sig_type=std_logic lab=AGND}
C {lab_wire.sym} 3640 -1540 2 0 {name=p9 sig_type=std_logic lab=AGND}
C {devices/code_shown.sym} 660 -670 0 0 {name=NGSPICE only_toplevel=true
value="

.control
destroy all
save all
set wr_vecnames
set wr_singlescale
option numdgt=15

shell mkdir -p /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt

shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt/NOM.op.txt
shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt/NOM.diff_ac.txt
shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt/NOM.cmrr_ac.txt
shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt/NOM.psrrp_ac.txt
shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt/NOM.psrrn_ac.txt

* OP
op

let vdd = v(AVDD)-v(AGND)
let vinp = v(INP)-v(AGND)
let vinn = v(INN)-v(AGND)
let vin_cm = 0.5*(v(INP)+v(INN))-v(AGND)
let vin_diff = v(INP)-v(INN)
let vcmdcoffset = v(VINCM)-v(VINCM0)
let vdiffdcoffset = v(VDIFFDCOFFSET)-v(AGND)
let voutp = v(OUTP)-v(AGND)
let voutn = v(OUTN)-v(AGND)
let vout_cm = 0.5*(v(OUTP)+v(OUTN))-v(AGND)
let vout_diff = v(OUTP)-v(OUTN)
let idd = -vavdd#branch

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt/NOM.op.txt vdd vinp vinn vin_cm vin_diff vcmdcoffset vdiffdcoffset voutp voutn vout_cm vout_diff v(REF) v(B) idd

* Diff AC
alter @VECG[ACMAG] = 1
alter @VECG[ACPHASE] = 0
alter @VCM0[ACMAG] = 0
alter @VAVDD[ACMAG] = 0
alter @VAVSS[ACMAG] = 0

ac dec 200 0.01 1G

let ac_vin_diff = v(INP)-v(INN)
let ac_vout_diff = v(OUTP)-v(OUTN)
let ac_vout_cm = 0.5*(v(OUTP)+v(OUTN))-v(AGND)

let vin_diff_real = real(ac_vin_diff)
let vin_diff_imag = imag(ac_vin_diff)
let vout_diff_real = real(ac_vout_diff)
let vout_diff_imag = imag(ac_vout_diff)
let vout_cm_real = real(ac_vout_cm)
let vout_cm_imag = imag(ac_vout_cm)

setscale frequency

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt/NOM.diff_ac.txt vin_diff_real vin_diff_imag vout_diff_real vout_diff_imag vout_cm_real vout_cm_imag

* CMRR
alter @VECG[ACMAG] = 0
alter @VCM0[ACMAG] = 1
alter @VCM0[ACPHASE] = 0
alter @VAVDD[ACMAG] = 0
alter @VAVSS[ACMAG] = 0

ac dec 200 0.01 1G

let ac_vin_cm = 0.5*(v(INP)+v(INN))-v(AGND)
let ac_vout_diff = v(OUTP)-v(OUTN)
let ac_vout_cm = 0.5*(v(OUTP)+v(OUTN))-v(AGND)

let vin_cm_real = real(ac_vin_cm)
let vin_cm_imag = imag(ac_vin_cm)
let vout_diff_real = real(ac_vout_diff)
let vout_diff_imag = imag(ac_vout_diff)
let vout_cm_real = real(ac_vout_cm)
let vout_cm_imag = imag(ac_vout_cm)

setscale frequency

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt/NOM.cmrr_ac.txt vin_cm_real vin_cm_imag vout_diff_real vout_diff_imag vout_cm_real vout_cm_imag

* PSRR+
alter @VECG[ACMAG] = 0
alter @VCM0[ACMAG] = 0
alter @VAVDD[ACMAG] = 1
alter @VAVDD[ACPHASE] = 0
alter @VAVSS[ACMAG] = 0

ac dec 200 0.01 1G

let ac_vavdd = v(AVDD)-v(AGND)
let ac_vout_diff = v(OUTP)-v(OUTN)
let ac_vout_cm = 0.5*(v(OUTP)+v(OUTN))-v(AGND)

let vavdd_real = real(ac_vavdd)
let vavdd_imag = imag(ac_vavdd)
let vout_diff_real = real(ac_vout_diff)
let vout_diff_imag = imag(ac_vout_diff)
let vout_cm_real = real(ac_vout_cm)
let vout_cm_imag = imag(ac_vout_cm)

setscale frequency

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt/NOM.psrrp_ac.txt vavdd_real vavdd_imag vout_diff_real vout_diff_imag vout_cm_real vout_cm_imag

* PSRR-
alter @VECG[ACMAG] = 0
alter @VCM0[ACMAG] = 0
alter @VAVDD[ACMAG] = 0
alter @VAVSS[ACMAG] = 1
alter @VAVSS[ACPHASE] = 0

ac dec 200 0.01 1G

let ac_vagnd = v(AGND)
let ac_vout_diff = v(OUTP)-v(OUTN)
let ac_vout_cm = 0.5*(v(OUTP)+v(OUTN))-v(AGND)

let vagnd_real = real(ac_vagnd)
let vagnd_imag = imag(ac_vagnd)
let vout_diff_real = real(ac_vout_diff)
let vout_diff_imag = imag(ac_vout_diff)
let vout_cm_real = real(ac_vout_cm)
let vout_cm_imag = imag(ac_vout_cm)

setscale frequency

wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt/NOM.psrrn_ac.txt vagnd_real vagnd_imag vout_diff_real vout_diff_imag vout_cm_real vout_cm_imag

quit
.endc
"}
