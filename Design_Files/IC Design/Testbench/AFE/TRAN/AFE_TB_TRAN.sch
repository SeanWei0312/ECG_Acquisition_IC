.include $::180MCU_MODELS/design.ngspice
.lib $::180MCU_MODELS/sm141064.ngspice typical

.temp 27
.param VDD_SET=3.3
"}
C {devices/code_shown.sym} 80 -550 0 0 {name=SETUP
only_toplevel=true
value="
.param VCM_SET=\{VDD_SET/2\}
.param IBIAS_SET=40u

.param CLK_FREQ=500
.param CLK_TR=80u
.param CLK_TF=80u
.param CLK_PW=\{0.5/CLK_FREQ-CLK_TR\}
.param CLK_DELAY_SET=1m

.param RST_ENABLE_SET=1
.param TRESET=10m
.param TRESET_END=10.001m

.param RST_PULSE_ENABLE_SET=0
.param RST_PULSE_ON_SET=40m
.param RST_PULSE_ON_END_SET=40.001m
.param RST_PULSE_OFF_SET=60m
.param RST_PULSE_OFF_END_SET=60.001m

.param SIG_DELAY_SET=100m

.param TEST_FREQ=60
.param ECG_AMP_SET=0

.param VDIFF_DC_SET=0
.param VCM_DC_SET=0
.param VCM_AC_SET=0

.param OFFSET_DELAY_SET=20m
.param OFFSET_RISE_SET=10m

.param VDD_RIPPLE_SET=0
.param VSS_RIPPLE_SET=0

.param S1_SET=3.3
.param S0_SET=3.3

.param RCM_SOURCE_SET=1

.param RELECP_SET=1
.param RELECN_SET=1

.param CELECP_SET=1f
.param CELECN_SET=1f

.param RLD_RETURN_SET=100T

.options method=gear
.options maxord=2

.options reltol=5e-3
.options abstol=1e-11
.options vntol=20u
.options chgtol=5e-13

.options itl1=1000
.options itl2=500
.options itl4=1500

.options gmin=1e-11
.options gminsteps=20
.options srcsteps=20
.options rshunt=100T

.options plotwinsize=0

.nodeset v(B)=2.3
.nodeset v(BODY)=\{VCM_SET\}

.nodeset v(INP)=\{VCM_SET\}
.nodeset v(INN)=\{VCM_SET\}

.nodeset v(OUTP)=\{VCM_SET\}
.nodeset v(OUTN)=\{VCM_SET\}

.nodeset v(RLD)=\{VCM_SET\}

.save v(AVDD) v(AGND)
.save v(BODY)
.save v(INP) v(INN)
.save v(OUTP) v(OUTN)
.save v(RLD)
.save v(RST) v(CLK)
"}
C {vsource.sym} 160 -930 0 0 {name=VAVSS
value="SIN(0 \{VSS_RIPPLE_SET\} \{TEST_FREQ\} \{SIG_DELAY_SET\})"
savecurrent=true}
C {gnd.sym} 160 -900 0 0 {name=l11 lab=0}
C {lab_wire.sym} 160 -980 0 0 {name=p8 sig_type=std_logic lab=AGND}
C {devices/code_shown.sym} 870 -730 0 0 {name=NGSPICE
only_toplevel=true
value="

.control

destroy all

set noaskquit
set wr_singlescale
unset wr_vecnames
set appendwrite

option numdgt=15
option sparse
option method=gear
option maxord=2
option plotwinsize=0

shell mkdir -p /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt

shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.diff_tran.txt
shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.cmrr_tran.txt
shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.psrrp_tran.txt
shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.psrrn_tran.txt

shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.vcmdcoffset_tran.txt
shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.vdiffdcoffset_tran.txt

shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.startup_with_reset.txt
shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.startup_without_reset.txt

shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.rld_off.txt
shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.rld_on.txt

shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.thd_tran.txt


* Common
alterparam CLK_FREQ=500
alterparam CLK_TR=80u
alterparam CLK_TF=80u
alterparam CLK_PW=920u
alterparam CLK_DELAY_SET=1m

alterparam ECG_AMP_SET=0
alterparam VDIFF_DC_SET=0

alterparam VCM_DC_SET=0
alterparam VCM_AC_SET=0

alterparam VDD_RIPPLE_SET=0
alterparam VSS_RIPPLE_SET=0

alterparam RST_ENABLE_SET=1
alterparam TRESET=10m
alterparam TRESET_END=10.001m

alterparam RST_PULSE_ENABLE_SET=0
alterparam RST_PULSE_ON_SET=40m
alterparam RST_PULSE_ON_END_SET=40.001m
alterparam RST_PULSE_OFF_SET=60m
alterparam RST_PULSE_OFF_END_SET=60.001m

alterparam SIG_DELAY_SET=100m

alterparam OFFSET_DELAY_SET=20m
alterparam OFFSET_RISE_SET=10m

alterparam RCM_SOURCE_SET=1

alterparam RELECP_SET=1
alterparam RELECN_SET=1

alterparam CELECP_SET=1f
alterparam CELECN_SET=1f

alterparam RLD_RETURN_SET=100T

alterparam S1_SET=3.3
alterparam S0_SET=3.3


* Differential response
alterparam ECG_AMP_SET=10u
alterparam VDIFF_DC_SET=0

alterparam VCM_DC_SET=0
alterparam VCM_AC_SET=0

alterparam VDD_RIPPLE_SET=0
alterparam VSS_RIPPLE_SET=0

alterparam RST_ENABLE_SET=0
alterparam RST_PULSE_ENABLE_SET=1

foreach gaincfg 0 1

    if $gaincfg = 0
        alterparam S1_SET=0
        alterparam S0_SET=0
    else
        alterparam S1_SET=3.3
        alterparam S0_SET=3.3
    end

    foreach freq 1000 500 250 150 60 10 1 0.5 0.1 0.05

        alterparam TEST_FREQ=$freq
        reset

        option method=gear
        option maxord=2
        option plotwinsize=0

        setplot const

        let ncycle=11
        let tprint=100u
        let tmax=20u

        if $freq = 500
            let ncycle=21
            let tprint=50u
        end

        if $freq >= 1000
            let ncycle=21
            let tprint=20u
        end

        if $freq = 10
            let ncycle=4
            let tprint=500u
        end

        if $freq = 1
            let ncycle=4
            let tprint=500u
        end

        if $freq < 1
            let ncycle=4
            let tprint=500u
        end

        if $freq < 0.1
            let ncycle=2
            let tprint=500u
        end

        let tstop=0.100+ncycle/$freq

        tran $&tprint $&tstop 0 $&tmax

        let tr_freq=time*0+$freq

        if $gaincfg = 0
            let tr_pga_gain=time*0+2
        else
            let tr_pga_gain=time*0+16
        end

        let tr_vin_cm=0.5*(v(INP)+v(INN))-v(AGND)
        let tr_vin_diff=v(INP,INN)

        let tr_vout_cm=0.5*(v(OUTP)+v(OUTN))-v(AGND)
        let tr_vout_diff=v(OUTP,OUTN)

        setscale time

        wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.diff_tran.txt tr_pga_gain tr_freq tr_vin_cm tr_vin_diff tr_vout_cm tr_vout_diff v(RST)

        destroy $curplot

    end
end


* CMRR
alterparam ECG_AMP_SET=0
alterparam VDIFF_DC_SET=0

alterparam VCM_DC_SET=0
alterparam VCM_AC_SET=50m

alterparam VDD_RIPPLE_SET=0
alterparam VSS_RIPPLE_SET=0

alterparam RST_ENABLE_SET=0
alterparam RST_PULSE_ENABLE_SET=1

foreach gaincfg 0 1

    if $gaincfg = 0
        alterparam S1_SET=0
        alterparam S0_SET=0
    else
        alterparam S1_SET=3.3
        alterparam S0_SET=3.3
    end

    foreach freq 1000 500 250 150 60

        alterparam TEST_FREQ=$freq
        reset

        option method=gear
        option maxord=2
        option plotwinsize=0

        setplot const

        let ncycle=31
        let tprint=100u
        let tmax=20u

        if $freq >= 250
            let tprint=50u
        end

        if $freq >= 1000
            let tprint=20u
        end

        let tstop=0.100+ncycle/$freq

        tran $&tprint $&tstop 0 $&tmax

        let tr_freq=time*0+$freq

        if $gaincfg = 0
            let tr_pga_gain=time*0+2
        else
            let tr_pga_gain=time*0+16
        end

        let tr_vin_cm=0.5*(v(INP)+v(INN))-v(AGND)

        let tr_vout_cm=0.5*(v(OUTP)+v(OUTN))-v(AGND)
        let tr_vout_diff=v(OUTP,OUTN)

        setscale time

        wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.cmrr_tran.txt tr_pga_gain tr_freq tr_vin_cm tr_vout_cm tr_vout_diff v(RST)

        destroy $curplot

    end
end


* PSRR+
alterparam ECG_AMP_SET=0
alterparam VDIFF_DC_SET=0

alterparam VCM_DC_SET=0
alterparam VCM_AC_SET=0

alterparam VDD_RIPPLE_SET=100m
alterparam VSS_RIPPLE_SET=0

alterparam RST_ENABLE_SET=0
alterparam RST_PULSE_ENABLE_SET=1

foreach gaincfg 0 1

    if $gaincfg = 0
        alterparam S1_SET=0
        alterparam S0_SET=0
    else
        alterparam S1_SET=3.3
        alterparam S0_SET=3.3
    end

    foreach freq 1000 500 250 150 60

        alterparam TEST_FREQ=$freq
        reset

        option method=gear
        option maxord=2
        option plotwinsize=0

        setplot const

        let ncycle=31
        let tprint=100u
        let tmax=20u

        if $freq >= 250
            let tprint=50u
        end

        if $freq >= 1000
            let tprint=20u
        end

        let tstop=0.100+ncycle/$freq

        tran $&tprint $&tstop 0 $&tmax

        let tr_freq=time*0+$freq

        if $gaincfg = 0
            let tr_pga_gain=time*0+2
        else
            let tr_pga_gain=time*0+16
        end

        let tr_supply_in=v(AVDD)-v(AGND)

        let tr_vout_cm=0.5*(v(OUTP)+v(OUTN))-v(AGND)
        let tr_vout_diff=v(OUTP,OUTN)

        setscale time

        wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.psrrp_tran.txt tr_pga_gain tr_freq tr_supply_in tr_vout_cm tr_vout_diff v(RST)

        destroy $curplot

    end
end


