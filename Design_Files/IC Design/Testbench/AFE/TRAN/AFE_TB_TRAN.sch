C {title.sym} 160 -40 0 0 {name=l1 author="Yi-Hsiang Wei"}
C {vsource.sym} 160 -1070 0 0 {name=VAVDD value="dc \{VDD_SET\} ac 0" savecurrent=true}
C {gnd.sym} 160 -1040 0 0 {name=l5 lab=0}
C {devices/code_shown.sym} 80 -730 0 0 {name=MODELS only_toplevel=true
format="tcleval( @value )"
value="
.include $::180MCU_MODELS/design.ngspice
.lib $::180MCU_MODELS/sm141064.ngspice typical
.temp 27
.param VDD_SET=3.3
"}
C {devices/code_shown.sym} 80 -580 0 0 {name=SETUP only_toplevel=true
value="
.param VCM_SET=\{VDD_SET/2\}
.param VCMDCOFFSET_SET=0
.param VDIFFDCOFFSET_SET=0
.param ECG_AMP=0.5m
.param ECG_FREQ=1

.options gmin=1e-12 rshunt=1e12 method=gear

.nodeset v(INP)=\{VCM_SET\} v(INN)=\{VCM_SET\}
.nodeset v(OUTP)=\{VCM_SET\} v(OUTN)=\{VCM_SET\}
.nodeset v(REF)=\{VCM_SET\}
.nodeset v(BSE1)=2.3 v(BSE2)=2.3
.nodeset v(BFDC)=2.3 v(BCMFB)=2.3
"}
C {vsource.sym} 160 -930 0 0 {name=VAVSS value="dc 0 ac 0"         savecurrent=true}
C {gnd.sym} 160 -900 0 0 {name=l11 lab=0}
C {lab_wire.sym} 160 -980 0 0 {name=p8 sig_type=std_logic lab=AGND}
C {devices/code_shown.sym} 650 -730 0 0 {name=NGSPICE only_toplevel=true
value="

.control
destroy all
save all
set wr_vecnames
set wr_singlescale
option numdgt=15

shell mkdir -p /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt
shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt/NOM.tran_*.txt


* VCM DC offset, 0.5m
alterparam VCMDCOFFSET_SET = 300m
alterparam VDIFFDCOFFSET_SET = 0
alterparam ECG_AMP = 0.5m
reset
save all
set wr_vecnames
set wr_singlescale
option numdgt=15
tran 0.5m 3
let tr_vcmdcoffset = v(VINCM)-v(VINCM0)
let tr_vdiffdcoffset = v(VDIFFDCOFFSET)-v(AGND)
let tr_vin_cm = 0.5*(v(INP)+v(INN))-v(AGND)
let tr_vin_diff = v(INP)-v(INN)
let tr_vout_cm = 0.5*(v(OUTP)+v(OUTN))-v(AGND)
let tr_vout_diff = v(OUTP)-v(OUTN)
let tr_idd = -vavdd#branch
setscale time
wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/AFE/NOM.Result_txt/NOM.tran_vcmdcoffset_p300m_0p5m.txt tr_vcmdcoffset tr_vdiffdcoffset tr_vin_cm tr_vin_diff v(INP) v(INN) v(OUTP) v(OUTN) tr_vout_cm tr_vout_diff tr_idd

