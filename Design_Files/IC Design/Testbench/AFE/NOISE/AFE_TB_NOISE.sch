C {title.sym} 160 -40 0 0 {name=l1 author="Yi-Hsiang Wei"}
C {devices/code_shown.sym} 80 -730 0 0 {name=MODELS
only_toplevel=true
format="tcleval( @value )"
value="
.include $::180MCU_MODELS/design.ngspice
.lib $::180MCU_MODELS/sm141064.ngspice typical

.temp 27
.param VDD_SET=3.3
"}
C {devices/code_shown.sym} 80 -550 0 0 {name=SETUP
only_toplevel=true
value="
.param VCM_SET=\{VDD_SET/2\}

.param VCMDCOFFSET_SET=0
.param VDIFFDCOFFSET_SET=0

.param IBIAS_SET=40u

.param S1_SET=3.3
.param S0_SET=3.3

.options sparse
.options method=gear

.options reltol=1e-3
.options abstol=1e-12
.options vntol=1u
.options chgtol=1e-14

.options itl1=2000
.options itl2=1000
.options itl4=2000

.options gmin=1e-12
.options rshunt=100T

.nodeset v(B)=2.3

.nodeset v(INP)=\{VCM_SET\}
.nodeset v(INN)=\{VCM_SET\}

.nodeset v(OUTP)=\{VCM_SET\}
.nodeset v(OUTN)=\{VCM_SET\}

.nodeset v(RLD)=\{VCM_SET\}

.save all
"}
C {devices/code_shown.sym} 870 -730 0 0 {name=NGSPICE
only_toplevel=true
value="

.control

destroy all

set noaskquit
set wr_singlescale
unset wr_vecnames
set appendwrite

unset sqrnoise

option numdgt=15
option sparse

shell mkdir -p /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt

shell rm -f /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.noise_diff.txt


* Differential noise: PGA G2 and G16
foreach gaincfg 0 1

    if $gaincfg = 0
        alterparam S1_SET=0
        alterparam S0_SET=0
    else
        alterparam S1_SET=3.3
        alterparam S0_SET=3.3
    end

    reset
    save all

    alter @VECG[ACMAG]=1
    alter @VECG[ACPHASE]=0

    alter @VCM0[ACMAG]=0
    alter @VCM0[ACPHASE]=0

    alter @VAVDD[ACMAG]=0
    alter @VAVDD[ACPHASE]=0

    alter @VAVSS[ACMAG]=0
    alter @VAVSS[ACPHASE]=0

    op

    noise v(OUTP,OUTN) VECG dec 300 0.01 1k

    * noise leaves the one-row integrated plot active
    * previous plot contains the noise-density spectrum
    setplot previous
    setscale frequency

    if $gaincfg = 0
        let noise_pga_gain=frequency*0+2
    else
        let noise_pga_gain=frequency*0+16
    end

    let noise_out_density=onoise_spectrum
    let noise_in_density=inoise_spectrum

    wrdata /foss/designs/ECG_Acquisition_IC/Measurement_Results/IC_Simulation/PATH/NOM.Result_txt/NOM.noise_diff.txt noise_pga_gain noise_out_density noise_in_density

    destroy all

end


* Last simulated setting is PGA G16

quit
.endc
"}
